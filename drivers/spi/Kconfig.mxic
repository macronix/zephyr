menuconfig SPI_MXIC_UEFC
	bool "MXIC UEFC SPI controller driver"
	default y
	depends on DT_HAS_XLNX_MXIC_UEFC_SPI_ENABLED
	help
	  Enable the Macronix UEFC host controller driver for the standard
	  SPI subsystem (PIO/IO transfer mode only).
